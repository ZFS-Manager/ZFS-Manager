# Copy to .env and adjust before first start.

# Port the web UI (and API) is exposed on
ZFS_WEB_PORT=8080

# Admin login password — change this!
ADMIN_PASSWORD=admin123

# PostgreSQL password for the metrics database
POSTGRES_PASSWORD=zfs_secret

# Optional: base64-encoded 32-byte master key for module secret encryption.
# Generate with: openssl rand -base64 32
# When unset, a key is generated automatically and stored in the data dir.
ZFS_SECRETS_MASTER_KEY=
